[Unit]
Description=Sapo API & panel (sapo-api)
Documentation=https://github.com/mehuli-id/sapo
# time-sync.target: sertifikat HTTPS dibuat dengan jam yang sudah benar
# (papan tanpa RTC menyala dengan jam mundur sampai NTP sinkron).
After=sapod.service network-online.target time-sync.target
Wants=sapod.service network-online.target

[Service]
Type=simple
User=sapo
Group=sapo
ExecStart=/usr/lib/sapo/sapo-api -config /etc/sapo/sapo.yaml -defaults /usr/share/sapo/sapo.yaml
Restart=on-failure
RestartSec=2s
StateDirectory=sapo
StateDirectoryMode=0750
# Koneksi ke socket sapod tidak butuh izin tulis pada sistem file, jadi
# /run/sapo tidak perlu (dan tidak boleh wajib) ada saat layanan dimulai.
#
# sapo-api tidak pernah butuh hak root, akses disk sistem, atau proses lain.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
RemoveIPC=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Syscall yang terlewat gagal dengan EPERM, bukan mematikan proses.
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
