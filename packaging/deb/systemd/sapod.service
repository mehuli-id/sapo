[Unit]
Description=Sapo System Agent (sapod)
Documentation=https://github.com/mehuli-id/sapo
After=local-fs.target network.target

[Service]
Type=simple
ExecStart=/usr/lib/sapo/sapod -config /etc/sapo/sapo.yaml -defaults /usr/share/sapo/sapo.yaml
Restart=on-failure
RestartSec=2s
# /run/sapo (tempat socket) tidak dihapus saat sapod restart, agar sapo-api
# tidak kehilangan direktori yang dipakainya.
RuntimeDirectory=sapo
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
# sapod adalah pengelola sistem: ia akan memasang paket (apt), mengatur
# layanan, jam, dan nama host. Pembatasan jaringan, NoNewPrivileges,
# ProtectClock, dan ProtectHostname SENGAJA tidak dipasang di sini karena
# diwarisi oleh proses anak (apt, skrip paket) dan akan merusaknya.
# Batas keamanannya ada di protokol: sapod hanya mendengarkan unix socket
# lokal dan hanya menjalankan operasi bernama yang terdaftar (ADR 0002).
LockPersonality=yes
RestrictRealtime=yes
# Cadangan file descriptor; sapod juga membatasi koneksi bersamaan sendiri.
LimitNOFILE=8192
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
