#!/bin/sh
# postinst untuk paket sapo.
set -e

DATA_DIR=/var/lib/sapo
CONF=/etc/sapo/sapo.yaml
PORT_HINT=5000
UNITS="sapod.service sapo-api.service"

case "$1" in
  configure)
    # 1. User & grup sistem "sapo".
    if command -v systemd-sysusers >/dev/null 2>&1; then
      systemd-sysusers sapo.conf
    else
      getent group sapo >/dev/null || groupadd --system sapo
      getent passwd sapo >/dev/null || useradd --system --gid sapo --home-dir "$DATA_DIR" \
        --no-create-home --shell /usr/sbin/nologin --comment "Sapo API" sapo
    fi

    # 2. Direktori data panel (akun & log audit). Bukan tempat file pengguna.
    install -d -o sapo -g sapo -m 0750 "$DATA_DIR"

    # 3. Konfigurasi admin. Nilai bawaan ada di /usr/share/sapo/sapo.yaml
    #    (ikut diperbarui paket); file ini hanya berisi nilai yang diubah admin
    #    atau panel, jadi upgrade tidak pernah menimpanya atau bertanya.
    if [ ! -e "$CONF" ]; then
      install -d -m 0755 /etc/sapo
      cat > "$CONF" <<'EOF'
# Konfigurasi Sapo yang diubah admin atau panel.
# Nilai bawaan dan penjelasannya ada di /usr/share/sapo/sapo.yaml.
# Tulis di sini hanya nilai yang ingin diganti, misalnya:
#
# api:
#   hostnames: [nas.kantor.lan]
EOF
      chmod 0644 "$CONF"
    fi

    # 3b. NFS hanya versi 4 (ADR 0007, /etc/nfs.conf.d/sapo.conf): rpcbind
    #     tidak dibutuhkan dan tidak dibuka di jaringan. Hanya saat pasang
    #     pertama, agar keputusan admin setelahnya dihormati.
    if [ -z "$2" ]; then
      systemctl mask rpcbind.socket rpcbind.service >/dev/null 2>&1 || true
    fi

    # 4. Layanan. Diaktifkan pada instalasi pertama dan saat dipasang ulang
    #    setelah "remove" (status disimpan oleh deb-systemd-helper), tetapi
    #    keputusan admin untuk menonaktifkan layanan tetap dihormati.
    if command -v deb-systemd-helper >/dev/null 2>&1; then
      for u in $UNITS; do
        # Hanya melepas mask yang dibuat saat paket di-remove.
        deb-systemd-helper unmask "$u" >/dev/null 2>&1 || true
        # was-enabled bernilai benar untuk instalasi baru.
        if deb-systemd-helper --quiet was-enabled "$u"; then
          deb-systemd-helper enable "$u" >/dev/null || true
        else
          deb-systemd-helper update-state "$u" >/dev/null || true
        fi
      done
    elif [ -z "$2" ]; then
      # Tanpa deb-systemd-helper (jarang): aktifkan saat pasang pertama.
      # Juga berjalan di chroot (misalnya saat membangun ISO).
      systemctl enable $UNITS >/dev/null 2>&1 || true
    fi
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || true
      if [ -z "$2" ]; then
        systemctl start $UNITS || echo "Peringatan: layanan Sapo gagal dinyalakan; cek 'journalctl -u sapo-api'." >&2
      else
        systemctl try-restart $UNITS || true
      fi
    fi

    # 5. Menu darurat di tty1 (ADR 0008) menggantikan layar login tty1.
    #    Sekali saja (penanda di /var/lib/sapod), agar keputusan admin untuk
    #    mematikannya tetap dihormati saat upgrade. Saat upgrade, layar
    #    login tty1 tidak dihentikan sekarang (admin mungkin sedang menjalankan
    #    apt di sana); menu tampil setelah boot berikutnya.
    CONSOLE_MARK=/var/lib/sapod/console-menu-enabled
    if [ ! -e "$CONSOLE_MARK" ]; then
      systemctl mask getty@tty1.service >/dev/null 2>&1 || true
      systemctl enable sapo-console@tty1.service >/dev/null 2>&1 || true
      install -d -m 0700 /var/lib/sapod
      : > "$CONSOLE_MARK"
      if [ -d /run/systemd/system ] && [ -z "$2" ]; then
        systemctl stop getty@tty1.service >/dev/null 2>&1 || true
        systemctl start sapo-console@tty1.service || true
      fi
    elif [ -d /run/systemd/system ] && [ -n "$2" ]; then
      systemctl try-restart sapo-console@tty1.service || true
    fi

    if [ -z "$2" ]; then
      host=$(hostname 2>/dev/null || echo sapo)
      echo ""
      echo "Sapo terpasang. Buka panel dari komputer di jaringan yang sama:"
      echo "  http://$host.local:$PORT_HINT  atau  http://<alamat-IP-NAS>:$PORT_HINT"
      echo "Halaman itu mengarahkan ke panel HTTPS dan menampilkan sidik jari"
      echo "sertifikat untuk dicocokkan (juga di layar login konsol), lalu ikuti"
      echo "wizard setup awal."
      echo ""
    fi
    ;;
esac

exit 0
