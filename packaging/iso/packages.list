# Paket di sistem live selain kernel (dipilih live-build). Paket sistem inti
# ikut terpasang lewat Depends paket sapo (manifest fitur "always").
sapo
live-boot
live-config
live-config-systemd
# Firmware kartu jaringan kabel (Realtek, Broadcom, dan lainnya) dan
# microcode CPU untuk komputer sungguhan (area non-free-firmware).
firmware-realtek
firmware-bnx2
firmware-bnx2x
firmware-misc-nonfree
amd64-microcode
intel-microcode
# Pool ZFS (fitur storage-zfs). Modul dikompilasi DKMS saat ISO dibangun,
# jadi header kernel ikut terpasang.
linux-headers-amd64
zfs-dkms
zfsutils-linux
# Berbagi file SMB (fitur smb) dan ACL POSIX untuk izin shared folder;
# modul VFS: tempat sampah (recycle) dan Time Machine (fruit, catia,
# streams_xattr).
samba
samba-vfs-modules
acl
# Berbagi file NFS (fitur nfs, NFS versi 4 saja).
nfs-kernel-server
# App Center (fitur app-center, ADR 0012): Podman + Quadlet.
podman
# Installer ke disk (ADR 0016): partisi, format, dan GRUB untuk BIOS dan UEFI.
gdisk
dosfstools
grub-pc-bin
grub-efi-amd64-bin
# grub-install dan grub-mkconfig (grub-common ikut sebagai dependensi).
grub2-common
# SSH sengaja tidak dipasang: user live memakai password bawaan.
# Backup ke S3/cloud (ADR 0020).
restic
